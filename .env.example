# Copy to .env.local and fill in values. Never commit .env.local.
# Everything except GROQ_API_KEY is optional: features without their variables hide or fall back.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public: deployed site URL used for metadata, sitemap, resume and emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ── AI (chat assistant, case-study drafts, build log) ────────────────────────
# Server-only: Groq API key
GROQ_API_KEY=

# Server-only, optional: GitHub token (raises the API limit from 60 to 5000 req/h; no scopes needed)
GITHUB_TOKEN=

# ── Redis: live metrics, chat analytics, rate limits, contact leads ──────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret salt for hashing visitor IPs in rate limits (required for the Redis-backed limiter).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# ── Contact form ─────────────────────────────────────────────────────────────
# Signs the "minimum time on form" token (falls back to RATE_LIMIT_SALT). Same generator as above.
CONTACT_TOKEN_SECRET=

# Resend (resend.com): email to you + auto-reply to the sender
RESEND_API_KEY=
# Where submissions are delivered (your inbox)
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Aftab Dhalait <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Telegram notification (bot from @BotFather + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Cloudflare Turnstile (spam protection). Leave both empty to skip.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin (/admin/leads, Basic Auth). Leave empty to disable the admin area (404). ──
ADMIN_USER=
ADMIN_PASSWORD=

# ── Scripts only ─────────────────────────────────────────────────────────────
# Public site URL to monitor in the uptime check (falls back to NEXT_PUBLIC_SITE_URL)
SITE_URL=
