# Copy to .env.local and fill in values. Never commit .env.local.

# Server-only: Groq API key for /api/chat
GROQ_API_KEY=

# Public: EmailJS IDs for the contact form (safe to expose by design)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public: deployed site URL used for metadata, sitemap and robots (no trailing slash)
NEXT_PUBLIC_SITE_URL=
